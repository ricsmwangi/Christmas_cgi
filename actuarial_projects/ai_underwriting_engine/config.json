{
  "engine": {
    "version": "1.0.0",
    "name": "AI Underwriting Engine",
    "description": "Real-time insurance underwriting with AI/ML integration"
  },
  "server": {
    "port": 8080,
    "host": "0.0.0.0",
    "max_connections": 100,
    "timeout_seconds": 30
  },
  "models": {
    "directory": "./models",
    "cache_size_mb": 512,
    "gpu_acceleration": false,
    "inference_timeout_ms": 5000,
    "max_batch_size": 100
  },
  "features": {
    "cache_size_mb": 256,
    "max_features": 256,
    "normalization_enabled": true
  },
  "data": {
    "directory": "./data",
    "validation_enabled": true,
    "sources": [
      {
        "name": "applications_file",
        "type": "file",
        "path": "./data/applications.csv",
        "enabled": true
      },
      {
        "name": "applications_db",
        "type": "database",
        "connection_string": "postgresql://localhost/underwriting",
        "enabled": false
      }
    ]
  },
  "rules": {
    "enabled": true,
    "max_rules": 1024,
    "rule_files": [
      "./config/auto_rules.json",
      "./config/home_rules.json",
      "./config/life_rules.json"
    ]
  },
  "logging": {
    "level": "INFO",
    "file": "ai_underwriting.log",
    "max_size_mb": 100,
    "max_files": 5,
    "console_output": true
  },
  "monitoring": {
    "enabled": true,
    "metrics_port": 9090,
    "health_check_interval_seconds": 60,
    "performance_monitoring": true
  },
  "security": {
    "api_key_required": false,
    "rate_limiting": {
      "enabled": true,
      "requests_per_minute": 1000
    },
    "input_validation": true,
    "output_sanitization": true
  }
}